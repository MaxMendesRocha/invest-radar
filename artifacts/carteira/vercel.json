{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @workspace/carteira run build",
  "outputDirectory": "dist/public",
  "installCommand": "echo 'handled by buildCommand'",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://invest-radar-production.up.railway.app/api/:path*" }
  ]
}
